# ─────────────────────────────────────────────────────────────
# Burger Liga · Festival de votación con antifraude
# Copia este archivo a .env.local y completa los valores.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). Si se dejan vacíos, la app
# arranca en MODO DEMO en memoria (datos de ejemplo, sin persistencia).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al cliente ni subir a git.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto HMAC para firmar cookies, retos de voto y hashear IPs/huellas.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Opcional: Cloudflare Turnstile (captcha invisible) como capa extra.
# Si se dejan vacíos, la app funciona sin captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: URL pública del sitio, para metadatos Open Graph absolutos.
# Si falta se usa VERCEL_URL y, en local, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Modo demo en memoria: credenciales del panel admin (solo cuando no hay Supabase)
DEMO_ADMIN_EMAIL=admin@burgerliga.demo
DEMO_ADMIN_PASSWORD=demo1234
